<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.aivle</groupId>
    <artifactId>java-tutorial</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Java Tutorial Project</name>
    <description>Java 강의 예제 프로젝트 - Maven 멀티모듈</description>

    <!-- 서브 모듈 정의 -->
    <modules>
        <module>chap01</module>
        <module>chap02</module>
        <module>chap03</module>
        <module>chap04</module>
        <module>chap05</module>
        <module>chap06</module>
        <module>chap07</module>
        <module>chap08</module>
        <module>chap09</module>
        <module>chap10</module>
    </modules>

    <!-- 공통 속성 -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <java.version>17</java.version>
    </properties>

    <!-- 공통 의존성 관리 -->
    <dependencyManagement>
        <dependencies>
            <!-- JUnit 5 (필요시 테스트용) -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.10.1</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 공통 빌드 설정 -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
